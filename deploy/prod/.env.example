# DMS 生产环境变量示例（复制为 .env 后填写真实值；.env 不入库）
# 数据库
DB_PASSWORD=change-me-strong-password
# MinIO 对象存储
MINIO_ACCESS_KEY=dmsadmin
MINIO_SECRET_KEY=change-me-strong-minio-secret
# JWT 签名密钥（至少 64 字符随机串）
JWT_SECRET=change-me-64-char-random-secret-string
# 邮件（163 SMTP 授权码）
MAIL_USERNAME=vinkinyu@163.com
MAIL_PASSWORD=change-me-smtp-app-password
MAIL_FROM=vinkinyu@163.com
